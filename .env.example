# Variáveis de Ambiente Opcionais para Alta Disponibilidade

# 1. Opção Google Firebase (Plano Spark - 100% Gratuito e NUNCA pausa por inatividade)
# VITE_FIREBASE_DATABASE_URL=https://seu-projeto-firebase-default-rtdb.firebaseio.com

# 2. Opção Supabase (com GitHub Actions Keep-Alive ativo para prevenir pausa de 7 dias)
# VITE_SUPABASE_URL=https://seu-projeto.supabase.co
# VITE_SUPABASE_ANON_KEY=sua-anon-key-aqui

# 3. Credenciais do Painel de Administrador
VITE_ADMIN_PASSWORD=Admin123
